# artefactos de build (hd60s es un script shell; no lo ignores)
*.o
*.obj
*.a
iso_capture
audio_extract
offline_parser
spi_dump
probe_iso

# Runtime output
captures/
!captures/proof/.gitkeep

# material de referencia Elgato (no redistribuir: cada quien lo extrae del instalador Windows)
reference/*.dll
reference/*.DLL
reference/*.sys
reference/*.SYS
reference/*.inf
reference/*.INF
!reference/it680x_regs.h

# firmware Elgato (no redistribuir)
firmware/*.bin
firmware/*.img
firmware/*.fw

# Large binary captures / analysis intermediates
*.pcapng
*.pcap
analysis/audio_hunt/*.wav
analysis/audio_hunt/*.raw
analysis/audio_hunt/*.bin

# FX3 firmware disassembly (large intermediate files, generate locally)
*.dis
*.asm
scratchpad/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
