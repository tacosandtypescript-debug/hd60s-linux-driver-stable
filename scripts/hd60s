#!/bin/bash
# envoltorio HD60S
set -e
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
if [ -x "$SCRIPT_DIR/iso_capture" ]; then
  ROOT="$SCRIPT_DIR"
elif [ -x "$SCRIPT_DIR/../iso_capture" ]; then
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
else
  ROOT="$SCRIPT_DIR"
fi
source "$SCRIPT_DIR/hd60s-lib.sh"
cd "$ROOT"

CMD="${1:-help}"; SEC="${2:-}"
VDEV="/dev/video42"
# snd-aloop: iso_capture writes to playback hw:10,0; consumers read capture hw:10,1.
ADEV="hw:10,1"

# ---------- commands ----------
case "$CMD" in
  live)
    need_cmd tmux    tmux
    need_cmd mpv     mpv
    need_cmd arecord alsa-utils
    need_cmd aplay   alsa-utils
    prep
    tmux kill-session -t hd60s 2>/dev/null || true
    kill_capture
    HERE="$PWD"
    # Wayland: tmux a veces no hereda el env de la sesión, así que lo fijamos
    : "${WAYLAND_DISPLAY:=wayland-0}"
    : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
    tmux new-session -d -s hd60s -x 220 -y 55 \
        -e "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" -e "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    # panel 1 (arriba): iso_capture — corre sin límite hasta Ctrl+C (argv[1]=0 ≈ 100 años)
    # el audio sale por snd-aloop hw:10,0 → hw:10,1 hacia hd60s_capture
    tmux send-keys -t hd60s "cd $HERE && HD60S_INIT_TSV=analysis/init-p2-audio-fast.tsv HD60S_BURST_TSV=analysis/poststream-no9a.tsv HD60S_AUDIO_PW=0 \"$SCRIPT_DIR\"/hd60s-capture.sh" Enter
    # panel 2 (abajo): vista previa mpv — arranca a los 13s (HD60S_NO_MPV=1 lo desactiva)
    # si usas OBS, mpv no hace falta; sin preview: HD60S_NO_MPV=1
    if [ -z "${HD60S_NO_MPV:-}" ]; then
        tmux split-window -v -t hd60s
        tmux send-keys -t hd60s "sleep 13 && mpv --vo=wlshm --untimed --profile=low-latency --no-audio --demuxer-lavf-o=input_format=yuyv422,video_size=1920x1080 av://v4l2:$VDEV" Enter
        say "tmux 'hd60s' arrancado: arriba=iso_capture (sin límite, audio ALSA→PipeWire) / abajo=vista previa mpv"
    else
        say "tmux 'hd60s' arrancado: solo iso_capture (sin límite, audio ALSA→PipeWire) — HD60S_NO_MPV=1"
    fi
    say "  cambiar: Ctrl+B → flechas / salir: Ctrl+B → d / cerrar todo: Ctrl+B → q"
    sleep 3
    tmux attach -t hd60s
    kill_capture
    tmux kill-session -t hd60s 2>/dev/null || true
    say "fin"
    ;;

  obs)
    need_cmd obs obs-studio
    prep
    tmux kill-session -t hd60s 2>/dev/null || true
    kill_capture
    HERE="$PWD"
    tmux new-session -d -s hd60s -x 200 -y 50
    tmux send-keys -t hd60s "cd $HERE && \"$SCRIPT_DIR\"/hd60s-capture.sh" Enter
    say "iso_capture arrancado (tmux 'hd60s'). Esperando lock de vídeo 12s..."
    sleep 12
    say "arrancando OBS..."
    obs &
    say "configuración de OBS:"
    echo "  · vídeo V4L2: $VDEV (ElgatoHD60S) / 1920x1080 / 60fps / YUYV"
    echo "  · audio: PipeWire hd60s_capture (48 kHz estéreo)"
    ;;

  start)
    SEC="${SEC:-600}"
    prep
    say "iso_capture ${SEC}s (Ctrl+C para parar). En otra ventana: 'hd60s view'"
    exec sudo HD60S_INIT_TSV=analysis/init-p2-audio-fast.tsv HD60S_BURST_TSV=analysis/poststream-no9a.tsv HD60S_IT6802_RECOVER=1 ./iso_capture "$SEC" 2 5
    ;;

  view)
    need_cmd vlc vlc
    [ -e "$VDEV" ] || die "no existe $VDEV. Primero lanza vídeo con 'hd60s start'"
    say "VLC en $VDEV + $ADEV (baja latencia)..."
    exec vlc --no-video-title-show --no-osd \
        --v4l2-dev="$VDEV" --v4l2-chroma=YUYV \
        --v4l2-width=1920 --v4l2-height=1080 \
        --input-slave=alsa://$ADEV \
        --live-caching=0 --file-caching=0 --network-caching=0 \
        --clock-jitter=0 --clock-synchro=0 \
        --avcodec-fast --avcodec-hw=none \
        v4l2://$VDEV
    ;;

  view-mpv)
    need_cmd mpv mpv
    say "mpv mostrando $VDEV (Wayland nativo)..."
    exec mpv --vo=wlshm \
        --demuxer-lavf-format=v4l2 \
        --demuxer-lavf-o=input_format=yuyv422,video_size=1920x1080,framerate=60 \
        --profile=low-latency --no-cache --untimed --no-audio "$VDEV"
    ;;

  view-ffplay)
    need_cmd ffplay ffmpeg
    say "ffplay mostrando $VDEV..."
    exec ffplay -f v4l2 -input_format yuyv422 -video_size 1920x1080 -framerate 60 \
      -fflags nobuffer -flags low_delay -sync ext \
      -x 1280 -y 720 -vf 'scale=1280:720' "$VDEV"
    ;;

  view-guvc)
    need_cmd guvcview guvcview
    exec guvcview -d "$VDEV" -x 1280x720
    ;;

  audio-test)
    SEC="${SEC:-6}"
    prep
    kill_capture
    say "prueba de audio ${SEC}s..."
    sudo ./iso_capture "$SEC" 2 5
    say "extrayendo SEP de stream-iso.bin..."
    ./audio_extract captures/stream-iso.bin captures/sep.raw
    ffmpeg -f s16le -ar 48000 -ac 2 -i captures/sep.raw -y captures/sep.wav 2>&1 | tail -3
    say "listo captures/sep.wav. Comprueba con 'aplay captures/sep.wav'"
    ;;

  pt)
    SEC="${SEC:-60}"
    prep
    say "experimento passthrough (poststream) ${SEC}s..."
    exec sudo ./iso_capture "$SEC" 2 5 "" pt
    ;;

  ptx)
    SEC="${SEC:-60}"
    prep
    say "experimento passthrough + secuencia de liberación ${SEC}s..."
    exec sudo ./iso_capture "$SEC" 2 5 "" pt release
    ;;

  test)
    SEC="${SEC:-20}"
    prep
    say "prueba corta ${SEC}s (para ver stats)..."
    exec sudo ./iso_capture "$SEC" 2 5
    ;;

  minimal)
    SEC="${SEC:-30}"
    prep
    say "**modo mínimo** ${SEC}s: omite reset/init/burst (para no romper passthrough)"
    say "úsalo justo después de desconectar y volver a conectar el USB del HD60S"
    exec sudo HD60S_NO_RESET=1 HD60S_SKIP_INIT=1 HD60S_SKIP_BURST=1 ./iso_capture "$SEC" 2 5
    ;;

  stop)
    say "parando iso_capture..."
    kill_capture
    tmux kill-session -t hd60s 2>/dev/null || true
    say "listo"
    ;;

  audio-v2)
    # unmute de audio IT6802 con el reg correcto (serie 0x7D)
    SEC="${SEC:-30}"
    prep
    say "prueba unmute V2 ${SEC}s: IT6802 REG_RX_HWMuteCtrl=0x7D"
    exec sudo -E HD60S_AUDIO_V2=1 ./iso_capture "$SEC" 2 5
    ;;

  audio-win)
    # usa el init que mezcla comandos de audio sacados del pcap de Windows Elgato
    SEC="${SEC:-15}"
    prep
    say "prueba audio init de Windows ${SEC}s: analysis/init-p2-audio-fast.tsv"
    exec sudo -E HD60S_INIT_TSV=analysis/init-p2-audio-fast.tsv ./iso_capture "$SEC" 2 5
    ;;

  busy)
    say "procesos con $VDEV abierto:"
    sudo fuser -v "$VDEV" 2>&1 || echo "  (ninguno)"
    ;;

  doctor)
    echo "== hd60s doctor =="
    ok=0; warn=0; ng=0
    chk() {
        if eval "$2" >/dev/null 2>&1; then
            printf "  [OK]    %s\n" "$1"; ok=$((ok+1))
        else
            printf "  [FALLO] %s\n          → %s\n" "$1" "$3"; ng=$((ng+1))
        fi
    }
    avs() {
        if eval "$2" >/dev/null 2>&1; then
            printf "  [OK]    %s\n" "$1"; ok=$((ok+1))
        else
            printf "  [AVISO] %s\n          → %s\n" "$1" "$3"; warn=$((warn+1))
        fi
    }
    chk "iso_capture compilado"   "[ -x ./iso_capture ]"                     "clona el repo y ejecuta ./install.sh  (o make)"
    chk "v4l2loopback cargado"  "lsmod | grep -q v4l2loopback"              "sudo modprobe v4l2loopback video_nr=42 card_label=ElgatoHD60S exclusive_caps=1"
    chk "$VDEV existe"               "[ -e $VDEV ]"                              "carga v4l2loopback con video_nr=42"
    chk "/dev/v4l/by-id existe"  "[ -d /dev/v4l/by-id ]"                    "sudo systemd-tmpfiles --create /etc/tmpfiles.d/hd60s.conf"
    avs "symlink OBS by-id"      "[ -e /dev/v4l/by-id/elgato-hd60s-index0 ]" "sudo udevadm trigger --subsystem-match=video4linux"
    avs "HD60 S conectado (USB 0fd9:005e)" "usb_device_present"                    "enchufa el HD60 S a USB 3.0 y dale alimentación"
    avs "grupo video"            "id -nG | tr ' ' '\\n' | grep -qx video"    "sudo usermod -aG video $USER  (luego cierra sesión)"
    avs "comando hd60s en PATH"  "command -v hd60s"                          "./install.sh deja hd60s en /usr/local/bin"
    avs "servicio hd60s activo"  "systemctl --user is-active --quiet hd60s"  "systemctl --user enable --now hd60s"
    avs "sink hd60s_out"         "pactl list short sinks 2>/dev/null | grep -q hd60s_out" "systemctl --user restart hd60s"
    avs "fuente hd60s_capture"   "pactl list short sources 2>/dev/null | grep -q hd60s_capture" "systemctl --user restart hd60s"
    avs "obs"                      "command -v obs"                            "./install.sh --extras   o   sudo apt install -y obs-studio"
    echo
    echo "resultado: OK=$ok  avisos=$warn  fallos=$ng"
    if [ "$ng" != 0 ]; then
        echo "con './install.sh' se instala lo que falta"
        exit 1
    fi
    if [ "$warn" != 0 ]; then
        echo "el driver está instalado; los avisos no bloquean OBS si el USB está enchufado."
        exit 0
    fi
    echo "todo OK. En OBS: V4L2 → ElgatoHD60S  y  audio → hd60s_capture"
    ;;

  install)
    INSTALLER="$SCRIPT_DIR/hd60s-install.sh"
    [ -f "$INSTALLER" ] || die "no encuentro hd60s-install.sh. Clona el repo y ejecuta ./install.sh"
    if [ ! -f "$ROOT/Makefile" ]; then
        die "para instalar o actualizar hace falta el checkout. git clone … && ./install.sh"
    fi
    shift
    exec bash "$INSTALLER" "$@"
    ;;

  uninstall)
    UNINSTALLER="$SCRIPT_DIR/hd60s-uninstall.sh"
    [ -f "$UNINSTALLER" ] || die "no encuentro hd60s-uninstall.sh"
    exec bash "$UNINSTALLER"
    ;;

  install-deps)
    INSTALLER="$SCRIPT_DIR/hd60s-install.sh"
    [ -f "$INSTALLER" ] || die "no encuentro hd60s-install.sh. Clona el repo y ejecuta ./install.sh"
    say "instalando paquetes del sistema (incluye extras: OBS, mpv, tmux)..."
    exec bash "$INSTALLER" --deps-only --extras
    ;;

  help|--help|-h|"")
    cat <<EOF
hd60s — driver Elgato HD60 S (0fd9:005e)

Uso diario (tras ./install.sh):
  enchufa USB 3.0 y abre OBS → V4L2 ElgatoHD60S + audio hd60s_capture

  doctor         diagnóstico (módulos, USB, servicio)
  stop           para el servicio o iso_capture
  help           esta ayuda

Instalación (desde el checkout):
  install        ./install.sh
  uninstall      quita udev, el servicio y /usr/local
  install-deps   paquetes + extras (OBS, mpv, tmux)

Laboratorio (puede chocar con systemctl --user hd60s):
  live           tmux: captura + mpv
  obs            captura y abre OBS
  start [seg]    iso_capture en primer plano (600s)
  view           VLC en $VDEV
  view-mpv / view-ffplay / view-guvc
  test / minimal / audio-test / audio-v2
  busy           quién tiene abierto $VDEV

Vídeo=$VDEV  audio=hd60s_capture
EOF
    ;;

  *)
    err "comando desconocido: $CMD"
    echo "mira 'hd60s help' para la lista"
    exit 1
    ;;
esac
